{
  "schemaVersion": 1,
  "id": "omaclipsync",
  "name": "Omaclipsync",
  "version": "0.1.3",
  "description": "Text clipboard synchronization for the Omarchy bar.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omaclipsync",
    "description": "Text clipboard synchronization",
    "category": "Utility",
    "allowMultiple": false,
    "defaultSection": "right",
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Fallback polling interval (seconds)",
        "min": 30,
        "max": 300,
        "step": 1,
        "defaultValue": 60
      },
      {
        "key": "filterEnabled",
        "type": "boolean",
        "label": "Enable filter",
        "defaultValue": false
      },
      {
        "key": "historyEnabled",
        "type": "boolean",
        "label": "Save local history",
        "defaultValue": false
      }
    ]
  },
  "author": "Infinifar"
}
